# Copy to backend/.env for local development (config/settings.py loads it
# automatically). In production, paste these into your host's dashboard
# instead — real environment variables take precedence over .env.

# Required in production (DJANGO_DEBUG=False refuses to start on the
# insecure default key). Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# "True" for local development, "False" in production
DJANGO_DEBUG=False

# comma-separated, no spaces — the domain(s) this API is served from
DJANGO_ALLOWED_HOSTS=api.yourdomain.com

# comma-separated, full origin including scheme — the domain(s) the frontend is served from
DJANGO_CORS_ORIGINS=https://yourdomain.com

# set to "False" only if you are NOT serving over HTTPS (rare in production)
DJANGO_SSL_REDIRECT=True

# Required. PostgreSQL connection string.
#   local docker: postgres://app:app_password@localhost:5432/trackyourlife
#   Neon:         postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# (copy the Neon one from its dashboard's "Connect" dialog; keep ?sslmode=require)
DATABASE_URL=

# Uploaded media storage (avatars, songs, backgrounds, vision-board images).
# Required in production — the host's disk is wiped on every deploy. Leave all
# three empty locally to keep uploads in backend/media/ instead.
# Find them on the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# "True" (default) serves uploads through this API at /api/media/... instead of
# res.cloudinary.com — some ISPs block Cloudinary, so browsers there can't
# load those URLs directly. Set "False" to hand out Cloudinary CDN URLs.
CLOUDINARY_PROXY_MEDIA=True
