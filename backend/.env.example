# Copy to .env (and load it however your host expects — most PaaS providers
# just let you paste these into their dashboard) and fill in real values for
# production. Nothing here is read automatically by manage.py itself; these
# are plain os.environ lookups in config/settings.py.

# Required in production (DJANGO_DEBUG=False refuses to start on the
# insecure default key). Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# "True" for local development, "False" in production
DJANGO_DEBUG=False

# comma-separated, no spaces — the domain(s) this API is served from
DJANGO_ALLOWED_HOSTS=api.yourdomain.com

# comma-separated, full origin including scheme — the domain(s) the frontend is served from
DJANGO_CORS_ORIGINS=https://yourdomain.com

# set to "False" only if you are NOT serving over HTTPS (rare in production)
DJANGO_SSL_REDIRECT=True

# omit all three of these to fall back to local sqlite (fine for small/demo deployments)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
